// GPIO pin assignments.
// On Pico W, GP23/GP24/GP25/GP29 are reserved for the CYW43 WiFi chip.
#define PIN_RASEN_1  22
#define PIN_RASEN_2   3
#define PIN_BEETE_1  27
#define PIN_BEETE_2  17

#define MAX_RUNTIME_SECONDS (10 * 60)
